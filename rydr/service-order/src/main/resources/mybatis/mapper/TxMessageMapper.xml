<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.rydr.order.dao.TxMessageMapper">

    <resultMap id="BaseResultMap" type="com.rydr.order.entity.TxMessage">
        <id column="id" property="id" jdbcType="BIGINT"/>
        <result column="biz_key" property="bizKey" jdbcType="VARCHAR"/>
        <result column="topic" property="topic" jdbcType="VARCHAR"/>
        <result column="payload" property="payload" jdbcType="VARCHAR"/>
        <result column="status" property="status" jdbcType="INTEGER"/>
        <result column="retry" property="retry" jdbcType="INTEGER"/>
        <result column="next_retry_at" property="nextRetryAt" jdbcType="TIMESTAMP"/>
        <result column="create_time" property="createTime" jdbcType="TIMESTAMP"/>
        <result column="update_time" property="updateTime" jdbcType="TIMESTAMP"/>
    </resultMap>

    <sql id="Base_Column_List">
        id, biz_key, topic, payload, status, retry, next_retry_at, create_time, update_time
    </sql>

    <insert id="insert" parameterType="com.rydr.order.entity.TxMessage"
            useGeneratedKeys="true" keyProperty="id">
        insert into tx_message (biz_key, topic, payload, status, retry, next_retry_at, create_time, update_time)
        values (#{bizKey,jdbcType=VARCHAR}, #{topic,jdbcType=VARCHAR}, #{payload,jdbcType=VARCHAR},
                #{status,jdbcType=INTEGER}, #{retry,jdbcType=INTEGER}, #{nextRetryAt,jdbcType=TIMESTAMP},
                now(), now())
    </insert>

    <update id="updateStatus">
        update tx_message
        set status = #{status,jdbcType=INTEGER},
            retry = #{retry,jdbcType=INTEGER},
            next_retry_at = #{nextRetryAt,jdbcType=TIMESTAMP},
            update_time = now()
        where id = #{id,jdbcType=BIGINT}
    </update>

    <update id="markDone">
        update tx_message
        set status = 2, update_time = now()
        where id = #{id,jdbcType=BIGINT}
    </update>

    <!--
        Rows eligible for (re)delivery: INIT(0) / SENT(1) / FAIL(3).
        FAIL must be included, otherwise a message that failed once would enter a
        dead-letter state and never be retried again by the compensation job.
        DONE(2) is the terminal success state and is excluded.
    -->
    <select id="selectDue" resultMap="BaseResultMap">
        select
        <include refid="Base_Column_List"/>
        from tx_message
        where status in (0, 1, 3)
          and (next_retry_at is null or next_retry_at &lt;= now())
        order by id
        limit #{limit,jdbcType=INTEGER}
    </select>

    <select id="selectByBizKey" resultMap="BaseResultMap">
        select
        <include refid="Base_Column_List"/>
        from tx_message
        where biz_key = #{bizKey,jdbcType=VARCHAR}
    </select>

    <delete id="deleteByBizKey">
        delete from tx_message where biz_key = #{bizKey,jdbcType=VARCHAR}
    </delete>

</mapper>
